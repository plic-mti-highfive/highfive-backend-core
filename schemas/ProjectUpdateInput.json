{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 70
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "tags": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "label": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40
          },
          "tagId": {
            "type": "string"
          },
          "fulfilled": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": ["id", "label", "fulfilled"],
        "additionalProperties": false
      }
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "private"]
    },
    "participation": {
      "type": "string",
      "enum": ["open", "on_request", "on_invite"]
    }
  },
  "additionalProperties": false,
  "title": "ProjectUpdateInput"
}
