{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "q": {
      "type": "string",
      "maxLength": 200
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["projects", "users", "tags"]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sort": {
      "type": "string",
      "enum": ["recent", "popular", "relevant", "active"]
    },
    "cursor": {
      "type": "string"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "additionalProperties": false,
  "title": "SearchParams"
}
