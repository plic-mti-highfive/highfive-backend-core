{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "highfive_received",
        "comment_on_project",
        "reply_to_comment",
        "join_request_received",
        "join_request_accepted",
        "join_request_rejected",
        "invitation_received",
        "new_member",
        "announcement_on_followed_project",
        "task_assigned",
        "mention",
        "message_received",
        "admin_decision"
      ]
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["app", "email"]
      }
    }
  },
  "required": ["type", "channels"],
  "additionalProperties": false,
  "title": "NotificationPreference"
}
