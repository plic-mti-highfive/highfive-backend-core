{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 70
    },
    "tagline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "tags": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs": {
      "default": [],
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "label": {
            "type": "string",
            "minLength": 3,
            "maxLength": 40
          },
          "tagId": {
            "type": "string"
          },
          "fulfilled": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": ["id", "label", "fulfilled"],
        "additionalProperties": false
      }
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "private"]
    },
    "participation": {
      "type": "string",
      "enum": ["open", "on_request", "on_invite"]
    },
    "state": {
      "type": "string",
      "enum": ["draft", "active", "done", "archived"]
    },
    "highfiveCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "membersCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "teamPreview": {
      "default": [],
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 24,
            "pattern": "^[a-z0-9._-]+$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "avatar": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["id", "username", "avatar"],
        "additionalProperties": false
      }
    },
    "owner": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9._-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "avatar": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["id", "username", "avatar"],
      "additionalProperties": false
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "banner": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "url": {
          "type": "string",
          "pattern": "^(https?:\\/\\/|data:image\\/)"
        },
        "alt": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "focal": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": ["x", "y"],
          "additionalProperties": false
        }
      },
      "required": ["id", "url", "alt", "focal"],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "slug",
    "title",
    "tagline",
    "tags",
    "needs",
    "visibility",
    "participation",
    "state",
    "highfiveCount",
    "membersCount",
    "teamPreview",
    "owner"
  ],
  "additionalProperties": false,
  "title": "ProjectSummary"
}
