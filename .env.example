# Database (PostgreSQL) : Exemple
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=highfive
DB_PASSWORD=secret
DB_DATABASE=highfive_dev

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRATION=7d

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# App
PORT=3000
NODE_ENV=development

# Stockage objet (MinIO en dev, S3 en prod — acces via le SDK AWS S3)
# Ces noms sont ceux lus par src/shared/config/configuration.ts : ne pas
# utiliser AWS_* ni MINIO_USERNAME/MINIO_PASSWORD, ils sont ignores et les
# credentials retomberaient silencieusement sur minioadmin/minioadmin.
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=eu-west-3
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=highfive-core-bucket

# Service canvas (brainstorming collaboratif)
# CANVAS_JWT_SECRET doit valoir exactement le JWT_SECRET du service canvas,
# et CANVAS_INTERNAL_SECRET exactement son INTERNAL_SECRET : ce sont les deux
# secrets partages entre les deux backends.
CANVAS_URL=http://localhost:8585
CANVAS_WS_URL=ws://localhost:8585
CANVAS_JWT_SECRET=change-me-canvas
CANVAS_INTERNAL_SECRET=dev-internal-secret
CANVAS_TOKEN_EXPIRATION=1h

# Generation de taches a partir du canvas
OPENAI_TOKEN=secret
OPENAI_MODEL=gpt-4o-mini
