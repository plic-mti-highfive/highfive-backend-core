# Database (PostgreSQL) : Exemple
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=highfive
DB_PASSWORD=secret
DB_DATABASE=highfive_dev

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
