# App
PORT=3000
NODE_ENV=development
# Origines autorisees par CORS, separees par des virgules ; `*` en developpement.
CORS_ORIGINS=*

# Comptes d'administration, par adresse, separes par des virgules. Aucune route
# ne donne ce role : il se declare ici et nulle part ailleurs. La liste fait
# autorite dans les deux sens — un compte retire redevient membre au
# redemarrage.
ADMIN_EMAILS=

# Base de donnees (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=highfive
DB_PASSWORD=secret
DB_DATABASE=highfive_dev

# Sessions
# Les jetons sont opaques et stockes haches : ce sel doit etre secret et
# stable. Le changer deconnecte tout le monde.
SESSION_TOKEN_PEPPER=change-me-pepper
SESSION_TTL_DAYS=30

# Redis (files BullMQ vers le service IA)
REDIS_HOST=localhost
REDIS_PORT=6379

# Stockage objet (MinIO en dev, S3 en production)
MINIO_ENDPOINT=http://localhost:9000
# URL publique si differente de l'endpoint interne (reverse proxy, CDN).
# MINIO_PUBLIC_ENDPOINT=https://files.highfive.app
MINIO_REGION=eu-west-3
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=highfive-core-bucket

# Service canvas (Le Mur, Yjs/Hocuspocus)
# CANVAS_JWT_SECRET doit valoir exactement le JWT_SECRET du service canvas,
# et CANVAS_INTERNAL_SECRET exactement son INTERNAL_SECRET.
CANVAS_URL=http://localhost:8585
CANVAS_WS_URL=ws://localhost:8585
CANVAS_JWT_SECRET=change-me-canvas
CANVAS_INTERNAL_SECRET=dev-internal-secret
CANVAS_TOKEN_EXPIRATION=1h

# Service IA (FastAPI). Laisser vide desactive les recommandations : le fil
# retombe alors sur ses regles deterministes.
AI_URL=http://localhost:8000
# Le service IA est reste multi-tenant : on lui envoie ce tenant fixe.
AI_TENANT_ID=00000000-0000-4000-8000-000000000001
# Doit valoir exactement le JWT_SECRET du service IA : ses routes de
# matchmaking sont derriere un Bearer et lisent le tenant dans le jeton.
AI_JWT_SECRET=change-me-ai
AI_TIMEOUT_MS=12000

# Generation de taches a partir du Mur (hors contrat front, voir docs/REFACTO-V2.md)
OPENAI_TOKEN=
OPENAI_MODEL=gpt-4o-mini

# Assistant du chat du Mur (voir docs/WALL-CHAT.md). Le LLM n'est appele que par le core.
# fake = reponse deterministe sans reseau (tests, CI, e2e) ; openai = SDK openai.
LLM_PROVIDER=fake
# Cle du fournisseur openai (modele : OPENAI_MODEL). Vide = erreur francaise propre, pas de crash.
OPENAI_API_KEY=
# mention = repond aux messages contenant @ia ; all = a tous les messages.
ASSISTANT_TRIGGER=mention
# Delai maximal d'un appel LLM (par tentative) et tentatives supplementaires.
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2
# Budget estime de tokens d'entree (prompt systeme + historique) et plafond de messages relus.
LLM_CONTEXT_TOKEN_BUDGET=3000
LLM_CONTEXT_MAX_MESSAGES=50
# Jobs canvas_chat_message traites en parallele.
CHAT_CONSUMER_CONCURRENCY=5
