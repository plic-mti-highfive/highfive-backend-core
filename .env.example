# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# App
PORT=3000
NODE_ENV=development

# AWS S3 CONFIGURATION
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=eu-west-3

#MINIO CONFIGURATION
AWS_REGION=eu-west-3
